# Test Environment Configuration
# Copy this file to .env.test and update values as needed

# Frontend URL
BASE_URL=http://localhost:3000

# Backend API URL
API_URL=http://localhost:8080/api/v1

# Test Superadmin Credentials
TEST_SUPERADMIN_USERNAME=admin
TEST_SUPERADMIN_PASSWORD=admin123

# Test Timeouts (milliseconds)
TEST_TIMEOUT_SHORT=5000
TEST_TIMEOUT_MEDIUM=10000
TEST_TIMEOUT_LONG=30000

# Playwright Configuration
PLAYWRIGHT_WORKERS=4
PLAYWRIGHT_RETRIES=0
PLAYWRIGHT_HEADED=false
