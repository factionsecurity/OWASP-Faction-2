# Copy to .env and fill in, then: docker compose up -d
#
#   cp .env.example .env
#
# Everything below has a working default except the three secrets, which have
# none on purpose — compose refuses to start until you set them rather than
# bringing the install up with a published password.

# ─── Secrets ────────────────────────────────────────────────────────────────

# Signs every session token. Anyone holding it can mint a token for any user,
# so generate your own and keep it out of version control:
#
#   openssl rand -base64 48
#
# Must be at least 256 bits. Changing it later signs everyone out; it does not
# invalidate anything else.
JWT_SECRET=

# Database password. Read by both the database and the backend.
DATABASE_PASSWORD=

# Object storage password (MinIO's root password). Also read by both.
# Minimum 8 characters.
STORAGE_SECRET_KEY=

# ─── Where this install lives ───────────────────────────────────────────────

# Port on the host. The application is served over plain HTTP; put it behind a
# reverse proxy that terminates TLS for anything beyond a private network.
HTTP_PORT=8080

# The URL people actually reach this install at. Emailed links — password
# resets, notifications, SLA digests — are built from it, so localhost works
# only while nobody else needs to open one.
PUBLIC_URL=http://localhost:8080

# ─── Version ────────────────────────────────────────────────────────────────

# latest tracks the newest full release, so `docker compose pull && up -d`
# upgrades. Pin a version (e.g. 2.0.1) to choose when that happens — tags are
# published without the `v` the release itself carries. See DOCKER_QUICK_START.md.
FACTION_VERSION=latest

# ─── Optional ───────────────────────────────────────────────────────────────

# DATABASE_NAME=clientportal
# DATABASE_USERNAME=admin
# STORAGE_ACCESS_KEY=minioadmin
# STORAGE_BUCKET=assessments

# Failed logins before an account is disabled; 0 turns the lockout off.
# MAX_FAILED_LOGIN_ATTEMPTS=5

# When the daily SLA digest goes out (Spring cron: sec min hour dom mon dow).
# VULNERABILITY_DIGEST_CRON=0 0 8 * * *

# Session lifetime in milliseconds. Default is 24 hours.
# JWT_EXPIRATION=86400000

# LOG_LEVEL=INFO
